#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/xboard.ico"
1 VERSIONINFO
FILEVERSION @XBOARD_VERSION_NUMERIC@,0
PRODUCTVERSION @XBOARD_VERSION_NUMERIC@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fezcode\0"
            VALUE "FileDescription", "xboard Controller Keyboard\0"
            VALUE "FileVersion", "@XBOARD_APP_VERSION@\0"
            VALUE "ProductVersion", "@XBOARD_APP_VERSION@\0"
            VALUE "ProductName", "xboard\0"
            VALUE "OriginalFilename", "xboard.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
